#!/usr/bin/env python3
import os
import sys

# Portable path detection
target_file = "/Users/reeazmahmud/Desktop/Terminator-Project/core/terminator_multi_agent_orchestrator.py"

def fix_task_priority():
    if not os.path.exists(target_file):
        print(f"Error: File not found at {target_file}")
        sys.exit(1)

    with open(target_file, "r") as f:
        content = f.read()

    if "class TaskPriority" in content:
        print("TaskPriority already exists in the file.")
        return

    print("TaskPriority missing. Appending default implementation...")
    
    patch = """

from enum import Enum

class TaskPriority(Enum):
    LOW = 0
    MEDIUM = 1
    HIGH = 2
    CRITICAL = 3
"""
    
    with open(target_file, "a") as f:
        f.write(patch)
    
    print("✅ patched terminator_multi_agent_orchestrator.py")

if __name__ == "__main__":
    fix_task_priority()