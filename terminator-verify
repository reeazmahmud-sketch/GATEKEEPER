#!/usr/bin/env python3
import os

target = "/Users/reeazmahmud/Desktop/Terminator-Project/core/terminator_multi_agent_orchestrator.py"

def verify():
    if not os.path.exists(target):
        print(f"File not found: {target}")
        return

    print(f"--- Checking imports in {os.path.basename(target)} ---")
    with open(target, 'r') as f:
        lines = f.readlines()
        
    for i, line in enumerate(lines):
        if "import" in line and ("terminator_command_center" in line or "core." in line):
            print(f"Line {i+1}: {line.strip()}")

if __name__ == "__main__":
    verify()
